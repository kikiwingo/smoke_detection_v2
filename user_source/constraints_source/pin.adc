# TF卡 SD 引脚 (SPI模式, 与官方例程一致: SD_DCLK=A7, SD_MISO=E8, SD_MOSI=A8, SD_nCS=B12)
set_pin_assignment	{ SD_nCS }	{ LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ SD_DCLK }	{ LOCATION = A7; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ SD_MOSI }	{ LOCATION = A8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ SD_MISO }	{ LOCATION = E8; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# UART 调试输出 (TX=H1)
set_pin_assignment	{ O_uart_tx }	{ LOCATION = H1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }


